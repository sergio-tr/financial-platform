{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic Fixture Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","clock","randomSeed","fixtures"],
  "properties": {
    "schemaVersion": {"const": 1},
    "clock": {"type": "string", "format": "date-time"},
    "randomSeed": {"type": "integer", "minimum": 0},
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","kind","path","classification","contentHash","owner","normative"],
        "properties": {
          "id": {"type": "string", "pattern": "^FIX-[A-Z0-9][A-Z0-9-]*$"},
          "kind": {"enum": ["PERSONA","PORTFOLIO","GOLDEN","PROVIDER_SIMULATOR","WORKFLOW","SECURITY"]},
          "path": {"type": "string", "minLength": 1},
          "classification": {"const": "SYNTHETIC"},
          "contentHash": {"type": "string", "pattern": "^(PENDING|[0-9a-f]{64})$"},
          "owner": {"type": "string", "pattern": "^SER-[0-9]+$"},
          "normative": {"type": "boolean"}
        }
      }
    }
  }
}
