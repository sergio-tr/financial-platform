{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecretVault encrypted secret record (SYSTEM_SECURITY)",
  "description": "Persisted ciphertext envelope for one SecretVersion. No plaintext fields. P0-R43 / SER-106.",
  "type": "object",
  "required": [
    "secretRef",
    "secretVersionId",
    "workspaceId",
    "secretSlotId",
    "ownerBinding",
    "cryptoFormatVersion",
    "kekVersionId",
    "status",
    "contentNonceBase64",
    "ciphertextBase64",
    "authTagBase64",
    "wrappedDekBase64",
    "wrapNonceBase64",
    "wrapTagBase64"
  ],
  "additionalProperties": false,
  "properties": {
    "secretRef": {
      "type": "string",
      "description": "Opaque stable reference; never encodes plaintext."
    },
    "secretVersionId": {
      "type": "string",
      "description": "Immutable identifier for this ciphertext generation."
    },
    "workspaceId": {
      "type": "string",
      "description": "Tenancy binding; must match AAD and lease scope."
    },
    "secretSlotId": {
      "type": "string",
      "description": "Connector or integration slot binding."
    },
    "ownerBinding": {
      "type": "string",
      "description": "Owner/capability binding included in AAD."
    },
    "cryptoFormatVersion": {
      "type": "string",
      "const": "sergiotr-secret-envelope-v1"
    },
    "kekVersionId": {
      "type": "string",
      "description": "Identifies which SecretVault KEK version wrapped the DEK."
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "ROTATING",
        "REVOKED",
        "KEY_UNAVAILABLE_REAUTH_REQUIRED"
      ]
    },
    "contentNonceBase64": {
      "type": "string",
      "description": "96-bit GCM nonce for secret payload; base64 without padding optional."
    },
    "ciphertextBase64": {
      "type": "string",
      "description": "AES-256-GCM ciphertext of provider credential bytes."
    },
    "authTagBase64": {
      "type": "string",
      "description": "128-bit GCM tag for secret payload."
    },
    "wrappedDekBase64": {
      "type": "string",
      "description": "DEK wrapped under SecretVault KEK (separate nonce/AAD domain)."
    },
    "wrapNonceBase64": {
      "type": "string",
      "description": "96-bit GCM nonce for DEK wrap."
    },
    "wrapTagBase64": {
      "type": "string",
      "description": "128-bit GCM tag for DEK wrap."
    },
    "auditSafeMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rotatedFromVersionId": { "type": "string" },
        "createdAtUtc": { "type": "string", "format": "date-time" },
        "lastLeaseGrantAtUtc": { "type": "string", "format": "date-time" }
      }
    }
  }
}