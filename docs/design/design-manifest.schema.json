{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Manifest",
  "type": "object",
  "required": ["components"],
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "figmaNode", "tokens"],
        "properties": {
          "id": { "type": "string", "pattern": "^DES-[A-Za-z0-9_-]+$" },
          "figmaNode": { "type": "string" },
          "tokens": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

