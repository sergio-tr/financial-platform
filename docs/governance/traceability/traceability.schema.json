{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Traceability Graph Schema (SER-96 / P0-R37)",
  "type": "object",
  "required": ["schemaVersion", "mode", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "enum": ["PLANNING", "MATERIALIZED"] },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nodeType", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "nodeType": {
            "type": "string",
            "enum": [
              "REQUIREMENT",
              "NFR",
              "DECISION_PACK",
              "ADR",
              "USE_CASE",
              "SCHEMA",
              "MESSAGE",
              "ROUTE",
              "EVENT",
              "DESIGN",
              "TEST",
              "RUNBOOK",
              "LINEAR_ISSUE",
              "SOURCE_OWNER",
              "MIGRATION",
              "WORKFLOW_DEFINITION",
              "DOCUMENTATION",
              "RELEASE_CONTROL",
              "LEGACY_EXCEPTION"
            ]
          },
          "status": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "owner": { "type": "string", "minLength": 1 },
          "canonicalPath": { "type": "string", "minLength": 1 },
          "linearIssue": { "type": "string", "pattern": "^SER-[1-9][0-9]*$" },
          "externalRef": { "type": "string", "minLength": 1 },
          "metadata": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "relation", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "relation": {
            "type": "string",
            "enum": [
              "SATISFIES",
              "DERIVES_FROM",
              "CONSTRAINS",
              "IMPLEMENTS",
              "EXPOSES",
              "PRODUCES",
              "CONSUMES",
              "VERIFIES",
              "DOCUMENTS",
              "DESIGNS",
              "OWNED_BY",
              "MIGRATES",
              "SUPERSEDES",
              "RELEASES",
              "TRACKED_BY"
            ]
          },
          "to": { "type": "string", "minLength": 1 },
          "compatibilityReason": { "type": "string", "minLength": 1 },
          "compatibilityAuthorityRef": { "type": "string", "minLength": 1 },
          "compatibilityAuthorityRevision": { "type": "string", "minLength": 1 },
          "contractMajor": { "type": "string", "minLength": 1 },
          "removalRelease": { "type": "string", "minLength": 1 }
        }
      }
    },
    "legacyExceptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
