{
  "$description": "SER-51 space, radius, border, elevation, layout, breakpoints, sizing, motion",
  "space": {
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "10px" },
    "lg": { "$type": "dimension", "$value": "14px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "border": {
    "width": {
      "default": { "$type": "dimension", "$value": "1px" },
      "focus": { "$type": "dimension", "$value": "2px" }
    }
  },
  "elevation": {
    "none": { "$type": "shadow", "$value": "none" },
    "surface": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(11, 17, 23, 0.06), 0 1px 3px rgba(11, 17, 23, 0.08)"
    },
    "overlay": {
      "$type": "shadow",
      "$value": "0 12px 32px rgba(11, 17, 23, 0.18)"
    }
  },
  "layout": {
    "content": {
      "max": { "$type": "dimension", "$value": "1600px" }
    },
    "compact": {
      "gutter": { "$type": "dimension", "$value": "16px" }
    },
    "medium": {
      "gutter": { "$type": "dimension", "$value": "24px" }
    },
    "expanded": {
      "gutter": { "$type": "dimension", "$value": "32px" }
    },
    "sidebar": {
      "expanded": { "$type": "dimension", "$value": "240px" },
      "compact": { "$type": "dimension", "$value": "0px" }
    },
    "header": {
      "height": { "$type": "dimension", "$value": "64px" }
    },
    "dashboard": {
      "gap": { "$type": "dimension", "$value": "16px" }
    },
    "breakpoint": {
      "shell": {
        "compact": {
          "max": { "$type": "dimension", "$value": "767px" }
        },
        "medium": {
          "min": { "$type": "dimension", "$value": "768px" },
          "max": { "$type": "dimension", "$value": "1199px" }
        },
        "expanded": {
          "min": { "$type": "dimension", "$value": "1200px" }
        }
      }
    }
  },
  "size": {
    "control": {
      "sm": { "$type": "dimension", "$value": "32px" },
      "md": { "$type": "dimension", "$value": "40px" },
      "lg": { "$type": "dimension", "$value": "48px" }
    },
    "touch": {
      "minimum": { "$type": "dimension", "$value": "44px" }
    },
    "icon": {
      "sm": { "$type": "dimension", "$value": "16px" },
      "md": { "$type": "dimension", "$value": "20px" },
      "lg": { "$type": "dimension", "$value": "24px" }
    }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "normal": { "$type": "duration", "$value": "180ms" },
    "slow": { "$type": "duration", "$value": "280ms" },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [0.2, 0, 0, 1]
      }
    }
  }
}