{
  "$description": "SER-51 typography semantics — Inter",
  "type": {
    "display": {
      "metric": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "32px",
          "fontWeight": 600,
          "lineHeight": "38px",
          "fontStyle": "normal"
        }
      }
    },
    "heading": {
      "page": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "24px",
          "fontWeight": 600,
          "lineHeight": "32px"
        }
      },
      "section": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "18px",
          "fontWeight": 600,
          "lineHeight": "26px"
        }
      }
    },
    "body": {
      "primary": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "14px",
          "fontWeight": 400,
          "lineHeight": "20px"
        }
      },
      "strong": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "14px",
          "fontWeight": 600,
          "lineHeight": "20px"
        }
      },
      "secondary": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "13px",
          "fontWeight": 400,
          "lineHeight": "18px"
        }
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "12px",
        "fontWeight": 600,
        "lineHeight": "16px"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter",
        "fontSize": "11px",
        "fontWeight": 400,
        "lineHeight": "16px"
      }
    },
    "numeric": {
      "metric": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "32px",
          "fontWeight": 600,
          "lineHeight": "38px"
        },
        "$extensions": {
          "com.sergiotr.typography": {
            "fontVariantNumeric": "tabular-nums"
          }
        }
      },
      "table": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "13px",
          "fontWeight": 500,
          "lineHeight": "18px"
        },
        "$extensions": {
          "com.sergiotr.typography": {
            "fontVariantNumeric": "tabular-nums"
          }
        }
      }
    }
  }
}